# ---------------------------------------------------------------------------
# Payless — Robinhood Chain configuration
# https://robinhood.com/us/en/support/articles/robinhood-chain-mainnet/
# ---------------------------------------------------------------------------

# Your Robinhood Chain wallet address (0x…) that receives payments
WALLET_ADDRESS=0xYourRobinhoodChainWalletAddressHere

# x402 facilitator URL
FACILITATOR_URL=https://facilitator.x402.org

# --- Network -----------------------------------------------------------------
# Defaults below are Robinhood Chain mainnet. Override to point at another
# network. NEXT_PUBLIC_* variants are also read so the browser and the server
# agree on the same network.
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- Payment token -----------------------------------------------------------
# USDG (Paxos Global Dollar) is the stablecoin Payless settles in.
# Canonical addresses: https://docs.robinhood.com/chain/contracts/
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73

# --- $PAYLESS token gating ---------------------------------------------------
# ERC-20 contract for $PAYLESS on Robinhood Chain.
# Payless / PAYLESS · 18 decimals · 1,000,000,000 total supply.
PAYLESS_TOKEN_ADDRESS=0x18644D2828C9FD107e8fAEB1F2f978957eA5BD74
# Optional: skips an on-chain decimals() call if you know the value
PAYLESS_TOKEN_DECIMALS=18
# Shown in the site footer once set
NEXT_PUBLIC_PAYLESS_TOKEN_ADDRESS=0x18644D2828C9FD107e8fAEB1F2f978957eA5BD74

# --- Demo mode ---------------------------------------------------------------
# 'true' lets the playground simulate payments without signature verification
ENABLE_DEMO_PAYMENTS=false
# Local development only. Production ignores this flag entirely: it skips
# signature and chain verification, which in production means giving the API away.

# --- Shared stores (required on serverless) ----------------------------------
# Replay protection and subscription periods default to per-instance memory.
# On Vercel each instance keeps its own copy, so one payment could be spent
# once per warm instance. Point these at Upstash Redis before real volume.
# Vercel's KV_REST_API_* variables are read as a fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Wallet ownership proof (token gating, payment link deletion).
# Any long random string; rotate to invalidate all outstanding proof tokens.
# openssl rand -hex 32
PAYLESS_AUTH_SECRET=
